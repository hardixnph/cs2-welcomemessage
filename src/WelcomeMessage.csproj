<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WelcomeMessage</AssemblyName>
    <RootNamespace>WelcomeMessage</RootNamespace>
    <!-- true so MaxMind.GeoIP2 / MaxMind.Db end up next to WelcomeMessage.dll -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379" ExcludeAssets="runtime" />
    <PackageReference Include="MaxMind.GeoIP2" Version="5.3.0" />
  </ItemGroup>

  <!-- Microsoft.Extensions.* are already loaded by CounterStrikeSharp -->
  <Target Name="DropSharedAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Extensions.'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
